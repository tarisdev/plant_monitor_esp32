# Copy to web/.env (gitignored) and fill in. Read by Vite only (dev + build).
# Only keys starting with VITE_ are inlined into the bundle; any other key here would be ignored.
# WiFi / AP / Firebase-ESP credentials are NOT here — they go in firmware/plant_monitor.ino
# (README section 3.2). The writer account UID still goes into firestore.rules (README section 2.4).

# Pasted from Firebase → Project settings → Your apps → Web (README section 2.3)
VITE_FIREBASE_API_KEY="AIza..."
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXX"   # optional / tuỳ chọn
