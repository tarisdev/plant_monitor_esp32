rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // UID of the ESP32 writer account (Authentication -> Users); public read, only this UID may write
    function isWriter() {
      return request.auth != null && request.auth.uid == "";
    }

    match /plants/{plantId} {
      allow read: if true;
      allow write: if isWriter();

      match /latest/data {
        allow read: if true;
        allow write: if isWriter();
      }

      match /readings/{readingId} {
        allow read: if true;
        allow write: if isWriter();
      }
    }
  }
}
